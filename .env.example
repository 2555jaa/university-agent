# Local University AI Agent Configuration
# Copy this file to .env to configure your local environment.

# ==============================================================================
# Environment Selection
# ==============================================================================
# Strictly accepts: development, testing, or production.
# - development: Default. Uses ./data within repository for persistence.
# - testing: Enforces isolated ephemeral data under tempfile (never touches ./data).
# - production: Uses ~/.local/share/university-agent for persistence.
APP_ENV=development

# Optional data root directory override. Leave unset to use the APP_ENV-specific default.
# DATA_DIR=

# Application Information & Logging
APP_NAME="Local University AI Agent"
APP_VERSION="1.0.0"
LOG_LEVEL=INFO
DEBUG=false

# ==============================================================================
# Network & Host Binding
# ==============================================================================
HOST=127.0.0.1
PORT=8000

# ==============================================================================
# Ollama / Local Model Settings
# ==============================================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL=qwen2.5:3b
LOCAL_FALLBACK_MODEL=qwen2.5:0.5b
EMBEDDING_MODEL=nomic-embed-text
# Embedding provider: auto (prefers Ollama neural), ollama, or deterministic_hash
EMBEDDING_PROVIDER=auto

# ==============================================================================
# RAG & Information Retrieval Settings
# ==============================================================================
# Minimum hybrid similarity score threshold [0.0 - 1.0] to qualify as relevant
RAG_SIMILARITY_THRESHOLD=0.45
# Minimum semantic cosine similarity required when lexical overlap is 0.0 [0.0 - 1.0]
RAG_MIN_SEMANTIC_ONLY_SCORE=0.50
# Number of top relevant chunks to retrieve (>= 1)
RAG_TOP_K=4
# Enable hybrid search (dense semantic + sparse lexical)
RAG_HYBRID_SEARCH=true
# Hybrid score weight [0.0 - 1.0]: alpha * semantic + (1 - alpha) * lexical
RAG_HYBRID_ALPHA=0.65

# ==============================================================================
# Cloud AI Provider Settings (Optional)
# ==============================================================================
# Leave disabled (false) for 100% offline, local private operation.
CLOUD_ENABLED=false
CLOUD_PROVIDER=gemini
# CLOUD_API_KEY is required only when CLOUD_ENABLED=true. Keep secret!
# CLOUD_API_KEY=
CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CLOUD_MODEL=gemini-2.5-flash

# ==============================================================================
# Security & System Governance
# ==============================================================================
# Strict privacy: never route private academic documents to cloud
RESTRICT_TO_LOCAL=true
# Allowed directories for agent filesystem operations
# ALLOWED_DIRECTORIES=["data", "workspace", "documents"]
# Maximum allowed document upload file size in megabytes (> 0)
MAX_UPLOAD_SIZE_MB=25
# Timeout in seconds for tool actions (> 0)
ACTION_TIMEOUT_SECONDS=30
