# Local University AI Agent Configuration

# Select development (default), testing, or production explicitly when needed.
APP_ENV=development

# Optional local data root. Leave unset to use the APP_ENV-specific default.
# Development defaults to ./data; testing uses a dedicated temporary directory;
# production defaults to ~/.local/share/university-agent.
# DATA_DIR=
LOG_LEVEL=INFO

# Ollama / Local Model Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL=qwen2.5:1.5b
LOCAL_FALLBACK_MODEL=qwen2.5:0.5b
EMBEDDING_MODEL=nomic-embed-text

# Cloud AI Provider Settings (Optional - leave disabled for 100% offline private operation)
CLOUD_ENABLED=false
CLOUD_PROVIDER=gemini
# Set CLOUD_API_KEY in your private .env only when CLOUD_ENABLED=true.
# CLOUD_API_KEY=
CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CLOUD_MODEL=gemini-2.5-flash

# Security & Data Isolation
RESTRICT_TO_LOCAL=true
ACTION_TIMEOUT_SECONDS=30

# Network & Host
HOST=127.0.0.1
PORT=8000
DEBUG=false
