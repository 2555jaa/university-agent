# Local University AI Agent Configuration
# Copy this file to .env to configure your local environment.

# ==============================================================================
# Environment Selection
# ==============================================================================
# Strictly accepts: development, testing, or production.
# - development: Default. Uses ./data within repository for persistence.
# - testing: Enforces isolated ephemeral data under tempfile (never touches ./data).
# - production: Uses ~/.local/share/university-agent for persistence.
APP_ENV=development

# Optional data root directory override. Leave unset to use the APP_ENV-specific default.
# DATA_DIR=

# Application Information & Logging
APP_NAME="Local University AI Agent"
APP_VERSION="1.0.0"
LOG_LEVEL=INFO
DEBUG=false

# ==============================================================================
# Network & Host Binding
# ==============================================================================
HOST=127.0.0.1
PORT=8000

# ==============================================================================
# Ollama / Local Model Settings
# ==============================================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL=qwen2.5:3b
LOCAL_FALLBACK_MODEL=qwen2.5:0.5b
EMBEDDING_MODEL=nomic-embed-text
# Embedding provider: auto (prefers Ollama neural), ollama, or deterministic_hash
EMBEDDING_PROVIDER=auto

# ==============================================================================
# RAG & Information Retrieval Settings
# ==============================================================================
# Minimum hybrid similarity score threshold [0.0 - 1.0] to qualify as relevant
RAG_SIMILARITY_THRESHOLD=0.45
# Minimum semantic cosine similarity required when lexical overlap is 0.0 [0.0 - 1.0]
RAG_MIN_SEMANTIC_ONLY_SCORE=0.50
# Number of top relevant chunks to retrieve (>= 1)
RAG_TOP_K=4
# Enable hybrid search (dense semantic + sparse lexical)
RAG_HYBRID_SEARCH=true
# Hybrid score weight [0.0 - 1.0]: alpha * semantic + (1 - alpha) * lexical
RAG_HYBRID_ALPHA=0.65

# ==============================================================================
# Cloud AI Provider Settings (Optional)
# ==============================================================================
# Plug in any major cloud LLM provider simply by setting CLOUD_PROVIDER and CLOUD_API_KEY.
# No heavy vendor SDKs required; uses lightweight, fast HTTPX OpenAI-compatible endpoints.
#
# Cloud routing only triggers when ALL of the following conditions are met:
#   1. CLOUD_ENABLED=true (or CLOUD_API_KEY is configured)
#   2. RESTRICT_TO_LOCAL=false (see Security & System Governance below)
#   3. Query does NOT contain private/sensitive RAG document context (strict data fencing)
#
# --- Quick-Switch Provider Presets (Copy-Paste Ready) ---
#
# 1. OpenAI (Default):
#    CLOUD_PROVIDER=openai
#    CLOUD_API_KEY=sk-...
#    # Auto-resolves: CLOUD_BASE_URL=https://api.openai.com/v1, CLOUD_MODEL=gpt-4o-mini
#
# 2. Google Gemini:
#    CLOUD_PROVIDER=gemini
#    CLOUD_API_KEY=AIzaSy...
#    # Auto-resolves: CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai, CLOUD_MODEL=gemini-2.5-flash
#
# 3. Groq (Ultra-fast open weights):
#    CLOUD_PROVIDER=groq
#    CLOUD_API_KEY=gsk_...
#    # Auto-resolves: CLOUD_BASE_URL=https://api.groq.com/openai/v1, CLOUD_MODEL=llama-3.3-70b-versatile
#
# 4. Grok / xAI:
#    CLOUD_PROVIDER=grok
#    CLOUD_API_KEY=xai-...
#    # Auto-resolves: CLOUD_BASE_URL=https://api.x.ai/v1, CLOUD_MODEL=grok-2-latest
#
# 5. OpenRouter:
#    CLOUD_PROVIDER=openrouter
#    CLOUD_API_KEY=sk-or-v1-...
#    # Auto-resolves: CLOUD_BASE_URL=https://openrouter.ai/api/v1, CLOUD_MODEL=openai/gpt-4o-mini
#
# 6. Custom OpenAI-compatible endpoint (vLLM, Ollama remote, LiteLLM, LM Studio, etc.):
#    CLOUD_PROVIDER=custom
#    CLOUD_API_KEY=your-key
#    CLOUD_BASE_URL=https://your-custom-llm-host/v1
#    CLOUD_MODEL=your-model-name
#
CLOUD_ENABLED=true
CLOUD_PROVIDER=openai
# CLOUD_API_KEY=

# Optional manual overrides (only needed if overriding the preset default):
# CLOUD_BASE_URL=
# CLOUD_MODEL=

# ==============================================================================
# Security & System Governance
# ==============================================================================
# Strict privacy: set to true to force 100% offline local inference (Ollama only).
# Set RESTRICT_TO_LOCAL=false to allow complex reasoning queries to route to the cloud provider.
# Private academic lecture slides, notes, and RAG document context are ALWAYS fenced
# locally and never sent to cloud APIs regardless of this flag.
# RESTRICT_TO_LOCAL=false
RESTRICT_TO_LOCAL=true
# Allowed directories for agent filesystem operations
# ALLOWED_DIRECTORIES=["data", "workspace", "documents"]
# Maximum allowed document upload file size in megabytes (> 0)
MAX_UPLOAD_SIZE_MB=25
# Timeout in seconds for tool actions (> 0)
ACTION_TIMEOUT_SECONDS=30
