[Unit]
Description=Local University AI Agent Production Service
After=network.target

[Service]
Type=simple
User=jafarmkoko
WorkingDirectory=/home/jafarmkoko/Documents/projects/Projects/university-agent
Environment="APP_ENV=production"
Environment="HOST=127.0.0.1"
Environment="PORT=8000"
Environment="WORKERS=4"
ExecStart=/home/jafarmkoko/Documents/projects/Projects/university-agent/scripts/run_production.sh
Restart=always
RestartSec=3s
KillMode=mixed
TimeoutStopSec=15s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
